": 3}, {"inst": "National Taiwan University (ntu.edu.tw)", "name": "winnie1124", "email": "r11521706@ntu.edu.tw", "fname": "Wen-Ni", "guest": false, "lname": "Kuo", "order": 4}], "frTypes": [], "license": "Open Data Commons Attribution", "nhEvent": "Haiti Earthquake", "nhTypes": [{"id": "earthquake", "name": "Earthquake"}], "dataType": {"id": "dataset", "name": "Dataset"}, "fileObjs": [], "fileTags": [], "keywords": ["Earthquake", "Damage Assessment", "Satellite Imagery"], "nhEvents": [{"eventEnd": "2010-01-11T16:00:00Z", "latitude": "18.5944\u00b0 N", "location": "Port-Au-Prince, Haiti", "eventName": "Haiti Earthquake", "longitude": "72.3074\u00b0 W", "eventStart": "2010-01-11T16:00:00Z"}], "dataTypes": [{"id": "dataset", "name": "Dataset"}], "projectId": "PRJ-4169", "tombstone": false, "facilities": [], "nhEventEnd": "2010-01-11T16:00:00Z", "nhLatitude": "18.5944\u00b0 N", "nhLocation": "Port-Au-Prince, Haiti", "description": "The dataset consists of paired pre- and post-disaster satellite imageries of the 2010 Haiti Earthquake, \u00a0a magnitude 7.0 earthquake that struck Haiti at 16:53 local time on 12 January 2010. The satellite imagery pairs were captured by GeoEye-1 satellite with high resolution (0.5m/pixel) and available from the Maxar Open Data program (https://creativecommons.org/licenses/by-nc/4.0/legalcode). The pre and post-disaster imagery were taken on 09 January 2010 and 15 January 2010, respectively.\n\nThe featured imageries (approximately 3.51 km2 in total) cover the vicinity of Port-au-Prince, the capital of Haiti, and the area situated about 25 kilometers west of the earthquake\u2019s epicenter [18\u00b028\u2032N, 72\u00b032\u2032W]. These regions were severely affected by the earthquake, with the damaged seaport, roads, and buildings. In addition to pairs of pre- and post-disaster satellite images of the event, this dataset provides the label of the damage to buildings and roads. Over 9000 building segments are classified into four damage levels (\u201cNo damage,\u201d \u201cMinor,\u201d \u201cMajor,\u201d and \u201cDestroyed\u201d) and illustrated in different colors in the segmentation masks (.png). On the other hand, the undamaged and damaged road segments are denoted by line strings in .shp files.\u00a0All annotations were done by the in-house team with quality control.", "nhLongitude": "72.3074\u00b0 W", "projectType": "other", "teamMembers": [], "awardNumbers": [], "guestMembers": [], "nhEventStart": "2010-01-11T16:00:00Z", "hazmapperMaps": [], "referencedData": [], "associatedProjects": []}, "status": "published", "version": 1, "basePath": "/published-data/PRJ-4169/Project--haitibrd-a-labeled-satellite-imagery-dataset-for-building-and-road-damage-assessment-of-the-2010-haiti-earthquake", "projectType": "other", "publicationDate": "2023-12-06T08:37:11.057744", "id": "NODE_1d8aae8b-3ef6-4fe0-8688-be4154902714"}, {"name": "designsafe.project", "uuid": "3412546544117748206-242ac117-0001-012", "order": 0, "value": {"ef": "", "pi": "sylin", "dois": ["10.17603/ds2-fqat-4v02"], "coPis": ["marisaedocia", "fjtsai0726", "anne04282000", "winnie1124"], "title": "HaitiBRD: A labeled satellite imagery dataset for building and road damage assessment of the 2010 Haiti earthquake", "users": [{"inst": "National Taiwan University (ntu.edu.tw)", "role": "pi", "email": "szuyunlin@ntu.edu.tw", "fname": "Szu-Yun", "lname": "Lin", "username": "sylin"}, {"inst": "National Taiwan University (ntu.edu.tw)", "role": "co_pi", "email": "b10501081@ntu.edu.tw", "fname": "Marisa", "lname": "Edocia", "username": "marisaedocia"}, {"inst": "Asia University (edu.tw)", "role": "co_pi", "email": "r08521508@ntu.edu.tw", "fname": "Fang Jung", "lname": "Tsai", "username": "fjtsai0726"}, {"inst": "National Taiwan University (ntu.edu.tw)", "role": "co_pi", "email": "r11521711@ntu.edu.tw", "fname": "Lien an", "lname": "Chen", "username": "anne04282000"}, {"inst": "National Taiwan University (ntu.edu.tw)", "role": "co_pi", "email": "r11521706@n