{"data":{"id":"10.17603/ds2-fqat-4v02","type":"dois","attributes":{"doi":"10.17603/ds2-fqat-4v02","prefix":"10.17603","suffix":"ds2-fqat-4v02","identifiers":[{"identifier":"PRJ-4169","identifierType":"Project ID"}],"alternateIdentifiers":[{"alternateIdentifierType":"Project ID","alternateIdentifier":"PRJ-4169"}],"creators":[{"name":"Lin, Szu-Yun","givenName":"Szu-Yun","familyName":"Lin","affiliation":["National Taiwan University (ntu.edu.tw)"],"nameIdentifiers":[]},{"name":"Edocia, Marisa","givenName":"Marisa","familyName":"Edocia","affiliation":["National Taiwan University (ntu.edu.tw)"],"nameIdentifiers":[]},{"name":"Tsai, Fang Jung","givenName":"Fang Jung","familyName":"Tsai","affiliation":["Asia University (edu.tw)"],"nameIdentifiers":[]},{"name":"Chen, Lien an","givenName":"Lien an","familyName":"Chen","affiliation":["National Taiwan University (ntu.edu.tw)"],"nameIdentifiers":[]},{"name":"Kuo, Wen-Ni","givenName":"Wen-Ni","familyName":"Kuo","affiliation":["National Taiwan University (ntu.edu.tw)"],"nameIdentifiers":[]}],"titles":[{"title":"HaitiBRD: A labeled satellite imagery dataset for building and road damage assessment of the 2010 Haiti earthquake"}],"publisher":"Designsafe-CI","container":{},"publicationYear":2023,"subjects":[{"subject":"Earthquake"},{"subject":"Damage Assessment"},{"subject":"Satellite Imagery"}],"contributors":[{"name":"National Taiwan University (ntu.edu.tw)","nameType":"Organizational","contributorType":"HostingInstitution","affiliation":[],"nameIdentifiers":[]},{"name":"Asia University (edu.tw)","nameType":"Organizational","contributorType":"HostingInstitution","affiliation":[],"nameIdentifiers":[]}],"dates":[],"language":"en","types":{"ris":"DATA","bibtex":"misc","citeproc":"dataset","schemaOrg":"Dataset","resourceType":"Project/Dataset","resourceTypeGeneral":"Dataset"},"relatedIdentifiers":[{"relationType":"IsCitedBy","relatedIdentifier":"https://doi.org/10.1016/j.jobe.2025.113467","relatedIdentifierType":"DOI"},{"relationType":"IsCitedBy","relatedIdentifier":"https://doi.org/10.1016/j.ijdrr.2024.105091","relatedIdentifierType":"DOI"},{"relationType":"References","relatedIdentifier":"https://registry.opendata.aws/maxar-open-data/","relatedIdentifierType":"URL"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"lang":"en","rights":"Open Data Commons Attribution"}],"descriptions":[{"lang":"en-Us","description":"The dataset consists of paired pre- and post-disaster satellite imageries of the 2010 Haiti Earthquake,  a magnitude 7.0 earthquake that struck Haiti at 16:53 local time on 12 January 2010. The satellite imagery pairs were captured by GeoEye-1 satellite with high resolution (0.5m/pixel) and available from the Maxar Open Data program (https://creativecommons.org/licenses/by-nc/4.0/legalcode). The pre and post-disaster imagery were taken on 09 January 2010 and 15 January 2010, respectively. The featured imageries (approximately 3.51 km2 in total) cover the vicinity of Port-au-Prince, the capital of Haiti, and the area situated about 25 kilometers west of the earthquake’s epicenter [18°28′N, 72°32′W]. These regions were severely affected by the earthquake, with the damaged seaport, roads, and buildings. \n\nIn addition to pairs of pre- and post-disaster satellite images of the event, this dataset provides the label of the damage to buildings and roads. Over 9000 building segments are classified into four damage levels (“No damage,” “Minor,” “Major,” and “Destroyed”) and illustrated in different colors in the segmentation masks: green, yellow, orange, and, red respectively, with descriptions provided in the data report. On the other hand, the undamaged and damaged road segments are denoted by line strings in .shp files. All annotations were done by the in-house team with quality control.\n\nThe dataset is organized into two main directories. The cropped folder contains 20 pairs of cropped pre- and post-disaster satellite images with their corresponding labels, while the original folder contains the pre- and post-disaster imagery pair and annotations covering the full extent of the area of interest (AOI). ","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://www.designsafe-ci.org/data/browser/public/designsafe.storage.published/PRJ-4169/?version=2","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":736,"viewsOverTime":[{"yearMonth":"2023-12","total":4},{"yearMonth":"2024-01","total":2},{"yearMonth":"2024-02","total":8},{"yearMonth":"2024-03","total":16},{"yearMonth":"2024-04","total":14},{"yearMonth":"2024-05","total":15},{"yearMonth":"2024-06","total":8},{"yearMonth":"2024-07","total":42},{"yearMonth":"2024-08","total":65},{"yearMonth":"2024-09","total":70},{"yearMonth":"2024-10","total":41},{"yearMonth":"2024-11","total":33},{"yearMonth":"2024-12","total":28},{"yearMonth":"2025-01","total":64},{"yearMonth":"2025-02","total":51},{"yearMonth":"2025-03","total":46},{"yearMonth":"2025-04","total":34},{"yearMonth":"2025-05","total":35},{"yearMonth":"2025-06","total":38},{"yearMonth":"2025-07","total":6},{"yearMonth":"2025-08","total":7},{"yearMonth":"2025-09","total":6},{"yearMonth":"2025-10","total":11},{"yearMonth":"2025-11","total":9},{"yearMonth":"2025-12","total":7},{"yearMonth":"2026-01","total":7},{"yearMonth":"2026-02","total":7},{"yearMonth":"2026-03","total":7},{"yearMonth":"2026-04","total":12},{"yearMonth":"2026-05","total":7},{"yearMonth":"2026-06","total":7},{"yearMonth":"2026-07","total":6},{"yearMonth":"2026-08","total":12},{"yearMonth":"2026-09","total":11}],"downloadCount":316,"downloadsOverTime":[{"yearMonth":"2023-12","total":4},{"yearMonth":"2024-01","total":2},{"yearMonth":"2024-02","total":8},{"yearMonth":"2024-03","total":16},{"yearMonth":"2024-04","total":14},{"yearMonth":"2024-05","total":15},{"yearMonth":"2024-06","total":8},{"yearMonth":"2024-07",