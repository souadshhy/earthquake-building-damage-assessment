, "size": 398102623, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/44706940", "supplied_md5": "c9d56890f96fe7ec057b2dc61ad4d830", "computed_md5": "c9d56890f96fe7ec057b2dc61ad4d830", "mimetype": "application/zip"}, {"id": 44706946, "name": "HURRICANE-LAURA.zip", "size": 442409037, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/44706946", "supplied_md5": "8fefbe0718271ff643cb6967a093773d", "computed_md5": "8fefbe0718271ff643cb6967a093773d", "mimetype": "application/zip"}, {"id": 44707366, "name": "HURRICANE-DELTA.zip", "size": 978154590, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/44707366", "supplied_md5": "31095b0b924cc161740cd39addc6708b", "computed_md5": "31095b0b924cc161740cd39addc6708b", "mimetype": "application/zip"}, {"id": 44707363, "name": "HURRICANE-IRMA.zip", "size": 626815185, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/44707363", "supplied_md5": "b2cd90a338cf65d5fd17446ac8ea6945", "computed_md5": "b2cd90a338cf65d5fd17446ac8ea6945", "mimetype": "application/zip"}, {"id": 44708263, "name": "HURRICANE-DORIAN.zip", "size": 443226032, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/44708263", "supplied_md5": "69a480ae028990bce39adf2f4d737a61", "computed_md5": "69a480ae028990bce39adf2f4d737a61", "mimetype": "application/zip"}, {"id": 44708299, "name": "PAKISTAN-FLOODING.zip", "size": 2370825346, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/44708299", "supplied_md5": "6f1215e9dd5415764440654c3e6a906a", "computed_md5": "6f1215e9dd5415764440654c3e6a906a", "mimetype": "application/zip"}], "folder_structure": {}, "authors": [{"id": 14775598, "full_name": "Zeyu Wang", "first_name": "Zeyu", "last_name": "Wang", "is_active": true, "url_name": "Zeyu_Wang", "orcid_id": "0009-0002-0360-9906"}, {"id": 15215152, "full_name": "Feng Zhang", "first_name": "Feng", "last_name": "Zhang", "is_active": true, "url_name": "Feng_Zhang", "orcid_id": ""}, {"id": 18021808, "full_name": "chuyi wu", "first_name": "chuyi", "last_name": "wu", "is_active": true, "url_name": "chuyi_wu", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://figshare.com/articles/figure/An_Extended_Building_Damage_EBD_dataset_constructed_from_disaster-related_bi-temporal_remote_sensing_images_/25285009", "download_disabled": false, "description": "<p dir=\"ltr\">The Extended Building Damage (EBD) dataset is a large-size remote sensing sample library for building damage assessment tasks. It contains over 18,000 bi-temporal images and over 175,000 connected components for buildings. The raw images were collected from 12 disaster events and multiple natural disaster types, including hurricanes, earthquakes, flooding, volcanic eruptions, and tornadoes. The raw images of EBD were collected from the Maxar Open-data program (https://www.maxar.com/open-data).</p><p dir=\"ltr\">It is worth noting that our EBD is constructed by machine labeling and manual post-supervision. The annotation model was first pre-trained on the xBD dataset (https://xview2.org/dataset) and then fine-tuned on disaster-specific images in a semi-supervised setting. Accordingly, the EBD dataset can be referred to as:</p><ul><li>An <b>extended </b>set of the original xBD dataset.</li><li>An <b>extendable</b> dataset for new disasters, following a machine-driven and knowledge transfer paradigm of sample labeling.</li></ul><p dir=\"ltr\">Details for EBD dataset:</p><ul><li>Each sample is constructed as pre-disaster and post-disaster images, with 512\u00d7512 size and RGB 3-channels.</li><li>Annotation for each sample includes a binary building localization mask (255: building; 0: background), and a building damage mask (1: no-damage; 2: minor damage; 3: major damage; 4: destroyed; 0: background).</li><li>Each sample is named as \"{disaster event}_{image ID}_{pre/post}_disaster\".</li></ul><p></p>", "funding": null, "funding_list": [], "version": 2, "status": "public", "size": 14490529720, "created_date": "2024-06-17T07:35:12Z", "modified_date": "2024-06-17T07:39:39Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["Building damage", "Remote sensing", "Deep learning", "Natural disaster"], "keywords": ["Building damage", "Remote sensing", "Deep learning", "Natural disaster"], "categories": [{"id": 26635, "title": "Photogrammetry and remote sensing", "parent_id": 26623, "path": "/26212/26623/26635", "source_id": "401304", "taxonomy_id": 100}], "references": [], "has_linked_file": false, "citation": "Wang, Zeyu; Zhang, Feng; wu, chuyi (2024). An Extensible Building Damage (EBD) dataset constructed from disaster-related bi-temporal remote sensing images.. figshare. Figure. https://doi.org/10.6084/m9.figshare.25285009.v2", "related_materials": [], "is_embargoed": false, "embargo_date": null, "embargo_type": null, "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 25285009, "title": "An Extensible Building Damage (EBD) dataset constructed from disaster-related bi-temporal remote sensing images.", "doi": "10.6084/m9.figshare.25285009.v2", "handle": "", "url": "https://api.figshare.com/v2/articles/25285009", "published_date": "2024-06-17T07:35:12Z", "thumb": "", "defined_type": 1, "defined_type_name": "figure", "group_id": null, "url_private_api": "https://api.figshare.com/v2/account/articles/25285009", "url_public_api": "https://api.figshare.com/v2/articles/25285009", "url_private_html": "https://figshare.com/account/articles/25285009", "timeline": {"posted": "2024-06-17T07:35:12", "firstOnline": "2024-02-27"}, "resource_title": null, "resource_doi": null}